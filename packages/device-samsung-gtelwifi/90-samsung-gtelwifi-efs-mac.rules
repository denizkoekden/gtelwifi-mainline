# Factory WLAN and Bluetooth addresses from the EFS partition, when the
# interfaces appear (instead of bootmac, which only derives them from the
# serial number).
ACTION=="add", SUBSYSTEM=="net", KERNEL=="wlan0", TAG+="systemd", ENV{SYSTEMD_WANTS}+="samsung-gtelwifi-efs-mac@wlan.service"
ACTION=="add", SUBSYSTEM=="bluetooth", KERNEL=="hci0", TAG+="systemd", ENV{SYSTEMD_WANTS}+="samsung-gtelwifi-efs-mac@bluetooth.service"
