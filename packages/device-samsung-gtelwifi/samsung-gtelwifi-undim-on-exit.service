# Undim the display before shutdown, so that systemd-backlight saves the
# brightness the user chose and not Phosh's idle dim. See
# /usr/libexec/samsung-gtelwifi/undim-on-shutdown.
[Unit]
Description=Undim the display before shutdown
After=mobi.phosh.Shell.service
PartOf=graphical-session.target

[Service]
ExecStart=/usr/bin/systemd-inhibit --what=shutdown --mode=delay --who=samsung-gtelwifi --why="Restore the brightness before it is saved" /usr/libexec/samsung-gtelwifi/undim-on-shutdown
# re-arm after a cancelled shutdown
Restart=always
RestartSec=1

[Install]
WantedBy=graphical-session.target
