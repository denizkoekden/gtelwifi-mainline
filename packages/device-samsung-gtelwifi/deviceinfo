# Reference: <https://nura.eco/deviceinfo>
# Please use double quotes only. You can source this file in shell scripts.

deviceinfo_format_version="0"
deviceinfo_name="Samsung Galaxy Tab E 9.6 (SM-T560)"
deviceinfo_manufacturer="Samsung"
deviceinfo_codename="samsung-gtelwifi"
deviceinfo_year="2015"
deviceinfo_arch="armv7"

# Device related
deviceinfo_chassis="tablet"
deviceinfo_screen_width="800"
deviceinfo_screen_height="1280"
# simpledrm on the framebuffer that sboot leaves running (lcd_base=9ea44000)
deviceinfo_drm="true"
# zstd costs too much CPU per page on the Cortex-A7; lz4 compresses less but
# is much cheaper (zramstart in postmarketos-zram reads this key)
deviceinfo_zram_swap_algo="lz4"
# Fixed host-side MAC of the NCM link: with a random one macOS creates a new
# enX interface on every boot (and hangs on it while the Mac is locked).
# Locally administered, same as the bring-up initramfs used.
deviceinfo_usb_network_host_addr="02:00:00:73:56:02"
# KERNEL is only 16 MiB: keep the boot image's initramfs minimal, the rest
# goes to initramfs-extra on pmOS_boot (merged, boot.img was 20.3 MB)
deviceinfo_create_initfs_extra="true"
# mkinitfs 2.12 compresses with zstd unless told otherwise, but the initramfs
# (postmarketos-initramfs 3.12.5, extract_initramfs_extra) unpacks the extra
# archive with "gzip -d": a zstd one fails with "gzip: invalid magic".
# Temporary: mkinitfs after 2.12.0 hardcodes gzip (commit 2bbb7c5) and drops
# this key; dint rejects it, so remove before the MR.
deviceinfo_initfs_extra_compression="gzip"

# Bootloader related
# sboot (Spreadtrum, Samsung-signed) loads an Android boot image v0 from
# KERNEL and picks the DTB out of a dt.img with board-id "sprd,sc-id".
# It ignores the header addresses (kernel at 0x80008000, initrd at
# 0x85500000) and the header cmdline, see README.md.
deviceinfo_dtb="sc7730-samsung-gtelwifi"
deviceinfo_flash_method="heimdall-bootimg"
# Boot image goes to KERNEL (mmcblk0p20, 16 MiB), the heimdall default.
# TODO: confirm the PIT name with "heimdall print-pit" (GPT PARTNAME is
# "userdata"). SYSTEM is only 1.5 GiB, userdata 5.4 GiB.
deviceinfo_flash_heimdall_partition_rootfs="userdata"
deviceinfo_generate_bootimg="true"
deviceinfo_bootimg_qcdt="true"
deviceinfo_bootimg_qcdt_type="sprd"
deviceinfo_flash_offset_base="0x00000000"
deviceinfo_flash_offset_kernel="0x00008000"
deviceinfo_flash_offset_ramdisk="0x01000000"
deviceinfo_flash_offset_second="0x00f00000"
deviceinfo_flash_offset_tags="0x00000100"
deviceinfo_flash_pagesize="2048"
