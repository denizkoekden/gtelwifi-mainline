# Reference: <https://nura.eco/devicepkg>
maintainer="Deniz Kokden <koekdendeniz@gmail.com>"
pkgname=device-samsung-gtelwifi
pkgdesc="Samsung Galaxy Tab E 9.6 (SM-T560)"
pkgver=3
pkgrel=15
url="https://nura.eco"
license="MIT"
arch="armv7"
options="!check !archcheck"
# boot-deploy only checks for dtbTool-sprd and mkbootimg-osm0sis
# (deviceinfo_bootimg_qcdt_type="sprd"), the device package pulls them in.
depends="
	alsa-ucm-conf
	bluez-btmgmt
	dtbtool-sprd
	linux-samsung-gtelwifi
	mkbootimg-osm0sis
	postmarketos-base
	switcheroo-control
"
makedepends="devicepkg-dev"
subpackages="
	$pkgname-nonfree-firmware:nonfree_firmware
	$pkgname-systemd:_systemd
"
source="
	80-device-samsung-gtelwifi.preset
	80-device-samsung-gtelwifi.user-preset
	90-samsung-gtelwifi-audio.rules
	90-samsung-gtelwifi-efs-mac.rules
	91-samsung-gtelwifi-gpu-name.rules
	cpufreq-limit
	cpufreq.conf
	deviceinfo
	drirc.conf
	efs-mac
	samsung-gtelwifi-cpufreq-limit.service
	samsung-gtelwifi-efs-mac@.service
	samsung-gtelwifi-undim-on-exit.service
	samsung-gtelwifi-undim-on-shutdown
	ucm2/HiFi.conf
	ucm2/gtelwifi.conf
"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname

	# EGL on the display node -> lima (see drirc.conf)
	install -Dm644 "$srcdir"/drirc.conf \
		"$pkgdir"/usr/share/drirc.d/50-samsung-gtelwifi.conf

	# Speaker, headphones, mic: UCM laid out like alsa-ucm-conf (simple-card, long name "gtelwifi")
	local ucm="$pkgdir"/usr/share/alsa/ucm2
	install -Dm644 "$srcdir"/gtelwifi.conf "$srcdir"/HiFi.conf \
		-t "$ucm"/Unisoc/SC7730/gtelwifi/
	mkdir -p "$ucm"/conf.d/simple-card
	ln -s ../../Unisoc/SC7730/gtelwifi/gtelwifi.conf \
		"$ucm"/conf.d/simple-card/gtelwifi.conf
	# keeps the speaker path powered between sounds (the PA pops)
	install -Dm644 "$srcdir"/90-samsung-gtelwifi-audio.rules \
		-t "$pkgdir"/usr/lib/udev/rules.d/

	# GPU name for switcheroo-control (GNOME Settings, "Graphics")
	install -Dm644 "$srcdir"/91-samsung-gtelwifi-gpu-name.rules \
		-t "$pkgdir"/usr/lib/udev/rules.d/

	# factory WLAN/BT address from the efs partition, read on the device
	install -Dm755 "$srcdir"/efs-mac -t "$pkgdir"/usr/libexec/samsung-gtelwifi/

	# CPU limit (vendor 1300 MHz; the kernel offers OC steps up to 1612 MHz),
	# the /etc file is a config file and keeps local changes
	install -Dm755 "$srcdir"/cpufreq-limit -t "$pkgdir"/usr/libexec/samsung-gtelwifi/
	install -Dm644 "$srcdir"/cpufreq.conf -t "$pkgdir"/etc/samsung-gtelwifi/
}

_systemd() {
	pkgdesc="$pkgdesc (systemd units)"
	install_if="$pkgname=$pkgver-r$pkgrel systemd"
	depends=""
	install -Dm644 "$srcdir"/80-device-samsung-gtelwifi.preset \
		-t "$subpkgdir"/usr/lib/systemd/system-preset/
	install -Dm644 "$srcdir"/samsung-gtelwifi-cpufreq-limit.service \
		-t "$subpkgdir"/usr/lib/systemd/system/
	# efs-mac for wlan0/hci0 when they appear (udev SYSTEMD_WANTS)
	install -Dm644 "$srcdir"/samsung-gtelwifi-efs-mac@.service \
		-t "$subpkgdir"/usr/lib/systemd/system/
	install -Dm644 "$srcdir"/90-samsung-gtelwifi-efs-mac.rules \
		-t "$subpkgdir"/usr/lib/udev/rules.d/
	# undim before shutdown, so the next boot does not start dark (user
	# unit, enabled globally by the user preset)
	install -Dm755 "$srcdir"/samsung-gtelwifi-undim-on-shutdown \
		"$subpkgdir"/usr/libexec/samsung-gtelwifi/undim-on-shutdown
	install -Dm644 "$srcdir"/samsung-gtelwifi-undim-on-exit.service \
		-t "$subpkgdir"/usr/lib/systemd/user/
	install -Dm644 "$srcdir"/80-device-samsung-gtelwifi.user-preset \
		"$subpkgdir"/usr/lib/systemd/user-preset/80-device-samsung-gtelwifi.preset
}

nonfree_firmware() {
	pkgdesc="WiFi firmware"
	depends="firmware-samsung-gtelwifi-wifi"
	mkdir "$subpkgdir"
}

