# gtelwifi on postmarketOS/Nura, merged last (after pmos.config and
# gtelwifi.config). Overrides the buildkit choices that only make sense
# for the self-contained test kernel and adds what the kconfigcheck
# options depend on but allnoconfig leaves off.

# pmOS brings its own initramfs in the boot image and loads modules
CONFIG_INITRAMFS_SOURCE=""
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_RD_GZIP=y
CONFIG_RD_ZSTD=y

# pmOS boot/root are "subpartitions" inside userdata (losetup -P)
CONFIG_BLK_DEV=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_MSDOS_PARTITION=y
CONFIG_EFI_PARTITION=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_USE_FOR_EXT2=y
# vfat's defaults (FAT_DEFAULT_CODEPAGE=437, iocharset iso8859-1): without
# these every vfat mount fails with EINVAL, e.g. the initramfs log disk
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y

# systemd/udev/OpenRC basics that kconfigcheck does not list
CONFIG_FHANDLE=y
CONFIG_AUTOFS_FS=y
CONFIG_TMPFS_XATTR=y
CONFIG_POSIX_MQUEUE=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_CGROUP_BPF=y
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_INPUT_UINPUT=y

# Dependencies of kconfigcheck options: BTF/BPF_LSM (default),
# CGROUP_PERF (containers), the USB host side of "usb" and "input".
# dwc2 itself stays peripheral-only (USB_DWC2_PERIPHERAL).
CONFIG_DEBUG_KERNEL=y
CONFIG_BPF_SYSCALL=y
CONFIG_PERF_EVENTS=y
CONFIG_USB=y
CONFIG_USB_HID=m
CONFIG_SCSI=m
CONFIG_SOUND=y
CONFIG_SND=m
CONFIG_SND_USB=y
CONFIG_LEDS_CLASS=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_HW_RANDOM=y

# WiFi (patch 0013): brcmfmac as a module. Built in, it would probe from
# the initramfs, before the rootfs with /usr/lib/firmware is mounted.
CONFIG_CFG80211=m
CONFIG_BRCMFMAC=m
CONFIG_BRCMFMAC_SDIO=y

# Bluetooth (hci_bcm on UART0 via serdev) and exFAT as modules on pmOS,
# the buildkit has them built in. serdev itself must stay =y.
CONFIG_BT=m
CONFIG_BT_HCIUART=m
CONFIG_BT_HCIUART_BCM=y
CONFIG_EXFAT_FS=m
# Accelerometer LIS2HH12 (patch 0034) as a module; iio-sensor-proxy polls it
CONFIG_IIO_ST_ACCEL_3AXIS=m
CONFIG_IIO_ST_ACCEL_I2C_3AXIS=m
# lima (patches 0045/0046) as a module, so it can be blacklisted and
# loaded by hand while the GPU is new
CONFIG_DRM_LIMA=m
# Audio (patches 0052-0056) as modules like the rest of the sound stack
# (SND=m above); all of them autoload from their OF tables. sprd-dma as a
# module too, so it can be blacklisted: an earlier dmatest run hung the tab.
CONFIG_SPRD_DMA=m
CONFIG_SND_SOC=m
CONFIG_SND_SOC_SPRD=m
CONFIG_SND_SOC_SPRD_VBC_SC7730=m
CONFIG_SND_SOC_SC2723=m
CONFIG_SND_SIMPLE_CARD=m
# Camera (patches 0066-0071): media core built in, sensors and capture driver
# as modules (OF tables, they autoload)
CONFIG_VIDEO_SR200PC20M=m
CONFIG_VIDEO_SC7730_DCAM=m
CONFIG_VIDEO_S5K4ECGX=m

# kCFI enforcing (kconfigcheck "hardening"); cfi.config from the buildkit
# has the permissive variant for bring-up
CONFIG_CFI_PERMISSIVE=n
