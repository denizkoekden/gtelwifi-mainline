#
# Samsung Galaxy Tab E 9.6 (SM-T560, gtelwifi), mainline kernel - DRAFT.
# Built on 02.11.2026 (lineage-24.0), never booted. Lines marked "check" are
# unverified.
#

# Inherit from mainline/common (LineageOS device tree for mainline-style
# kernels, pristine mainline explicitly supported)
include device/mainline/common/BoardConfigMainlineCommon.mk

DEVICE_PATH := device/samsung/gtelwifi

# Architecture: 4x Cortex-A7, ARMv7-A only (no AArch64)
TARGET_ARCH := arm
TARGET_ARCH_VARIANT := armv7-a-neon
TARGET_CPU_ABI := armeabi-v7a
TARGET_CPU_ABI2 := armeabi
TARGET_CPU_VARIANT := cortex-a7

# Platform
TARGET_BOARD_PLATFORM := sc7730
TARGET_BOOTLOADER_BOARD_NAME := SC7730SE
TARGET_NO_RADIOIMAGE := true

# Kernel: Linux 7.3.1 + patches/0001-0092 + 0100 (the Nura series), built inline
# with clang.
# One full defconfig, generated by lineageos/kernel/mergecheck.sh
# (allnoconfig + buildkit + AOSP/LineageOS fragments + our overrides, then
# savedefconfig; round trip checked). As base config kernel.mk would start
# from Kconfig defaults instead of allnoconfig, so no raw fragments here.
TARGET_KERNEL_SOURCE := kernel/samsung/gtelwifi
TARGET_KERNEL_CONFIG_EXT := $(DEVICE_PATH)/configs/kernel/gtelwifi_android_defconfig
BOARD_KERNEL_IMAGE_NAME := zImage
# Not a GKI kernel: kernel.mk defaults to mixed mode, which adds a system
# module list whose intermediates dir is empty where the zImage rule is
# defined ("/file_list.txt" missing, lineage-24.0)
TARGET_KERNEL_MIXED_MODE := false

# Graphics: first boot with TARGET_INITIAL_BRINGUP (SwiftShader + drmfb
# composer on sprd-dispc), Mesa lima with TARGET_GTELWIFI_LIMA (device.mk)
BOARD_MESA3D_GALLIUM_DRIVERS += lima
# minigbm: only the generic (dumb buffer) backends. The bring-up default
# "all" also builds i915.c, which uses x86 builtins and fails on arm.
# sprd-dispc is not in its list either; drv.c then falls back to the dumb
# backend for any KMS device.
$(call soong_config_set,minigbm_upstream,platform,generic)

# sboot ignores the header cmdline. Everything here (and the
# MAINLINE_COMMON_*_PARAMS) has to be mirrored in CONFIG_CMDLINE, see
# gtelwifi-android.config. Kept for documentation and the recovery.
BOARD_KERNEL_CMDLINE := $(MAINLINE_COMMON_KERNEL_PARAMS) $(MAINLINE_COMMON_ANDROIDBOOT_PARAMS)

# Boot image: header v0 + SPRD dt.img (mkbootimg.mk). sboot loads the
# kernel to 0x80008000 and the ramdisk to 0x85500000 whatever the header says.
BOARD_BOOT_HEADER_VERSION := 0
BOARD_KERNEL_BASE := 0x00000000
BOARD_KERNEL_PAGESIZE := 2048
BOARD_MKBOOTIMG_ARGS := --kernel_offset 0x00008000 --ramdisk_offset 0x01000000 \
    --second_offset 0x00f00000 --tags_offset 0x00000100 --header_version 0
BOARD_CUSTOM_BOOTIMG_MK := $(DEVICE_PATH)/mkbootimg.mk
BOARD_RAMDISK_USE_LZ4 := true

# No AVB, no A/B. Android 17 defaults AB_OTA_UPDATER to true when the board
# leaves it empty (core/board_config.mk), so non-A/B has to be explicit;
# otherwise the super size check halves the 1850 MiB (two slots).
BOARD_AVB_ENABLE := false
AB_OTA_UPDATER := false

# Partitions (sizes from the GPT, confirmed by the lineage-16.0 tree)
BOARD_FLASH_BLOCK_SIZE := 131072
BOARD_BOOTIMAGE_PARTITION_SIZE := 16777216
BOARD_RECOVERYIMAGE_PARTITION_SIZE := 16777216
BOARD_USERDATAIMAGE_FILE_SYSTEM_TYPE := ext4
TARGET_USERIMAGES_USE_EXT4 := true

# super spread over two physical partitions, metadata on SYSTEM.
# core/config.mk (lineage-24.0) takes several block devices with or without
# PRODUCT_RETROFIT_DYNAMIC_PARTITIONS; retrofit additionally builds the
# super_*.img OTA. The metadata device goes to the cmdline
# (androidboot.super_partition=SYSTEM, mirrored in CONFIG_CMDLINE because
# sboot drops BOARD_KERNEL_CMDLINE). Uppercase device names work (first
# boot 04.11.). HIDDEN (Samsung's preload) is /metadata instead (fstab):
# aconfigd and others need it, the first boot failed without.
BOARD_USES_METADATA_PARTITION := true
BOARD_SUPER_PARTITION_METADATA_DEVICE := SYSTEM
BOARD_SUPER_PARTITION_BLOCK_DEVICES := SYSTEM CSC
BOARD_SUPER_PARTITION_SYSTEM_DEVICE_SIZE := 1572864000
BOARD_SUPER_PARTITION_CSC_DEVICE_SIZE := 209715200
BOARD_SUPER_PARTITION_SIZE := 1782579200
BOARD_SUPER_PARTITION_GROUPS := gtelwifi_dynamic_partitions
BOARD_GTELWIFI_DYNAMIC_PARTITIONS_SIZE := 1778384896
# Kernel modules go to /vendor/lib/modules (dlkm_loader_mainline reads
# /vendor, /odm and /system lib/modules), no extra vendor_dlkm in super.
# Without a modules.load the loader loaded nothing (04.11.: no wlan0, no
# hci0). brcmfmac-cyw right after brcmfmac: brcmfmac needs it only in its
# asynchronous firmware callback, by then it is registered (request_module
# goes through vendor/bin/gtelwifi-modprobe as a fallback).
BOARD_VENDOR_KERNEL_MODULES_LOAD := \
    cfg80211.ko \
    brcmutil.ko \
    brcmfmac.ko \
    brcmfmac-cyw.ko \
    bluetooth.ko \
    btbcm.ko \
    hci_uart.ko
# brcmfmac without the firmware supplicant (BRCMF_FEAT_FWSUP, bit 13):
# Android's wpa_supplicant hands the PSK to the firmware when the driver
# offers 4WAY_HANDSHAKE_STA_PSK, the firmware completes the handshake, but
# the supplicant never sees the port authorized and gives up after 10 s
# with "4-Way Handshake failed - pre-shared key may be incorrect" (05.11.).
BOARD_VENDOR_KERNEL_MODULES_OPTIONS_FILE := $(DEVICE_PATH)/configs/kernel/modules.options
BOARD_GTELWIFI_DYNAMIC_PARTITIONS_PARTITION_LIST := system system_ext product vendor

BOARD_SYSTEMIMAGE_FILE_SYSTEM_TYPE := erofs
BOARD_SYSTEM_EXTIMAGE_FILE_SYSTEM_TYPE := erofs
BOARD_PRODUCTIMAGE_FILE_SYSTEM_TYPE := erofs
BOARD_VENDORIMAGE_FILE_SYSTEM_TYPE := erofs
BOARD_EROFS_COMPRESSOR := lz4
TARGET_COPY_OUT_SYSTEM_EXT := system_ext
TARGET_COPY_OUT_PRODUCT := product
TARGET_COPY_OUT_VENDOR := vendor

# Recovery: none for now, TWRP stays in RECOVERY as the rescue path and the
# images are flashed from our own rescue system (TWRP 3.5 knows no super).
# Building one failed anyway: the recovery ramdisk rule rsyncs
# $(TARGET_ROOT_OUT), which this layout never creates.
TARGET_NO_RECOVERY := true

# SELinux
BOARD_VENDOR_SEPOLICY_DIRS += $(DEVICE_PATH)/sepolicy/vendor

# Screen: 9.6", 800x1280 -> 157 ppi
TARGET_SCREEN_DENSITY := 160

# The stock GPS daemon and legacy HAL (proprietary/gps, device.mk) are copied
# as they are: they cannot be prebuilt modules, the build system would check
# their DT_NEEDED against the tree (libssl, libstdc++ of Android 4.4).
BUILD_BROKEN_ELF_PREBUILT_PRODUCT_COPY_FILES := true
