// Device settings under Settings > System: CPU overclocking (and room for
// later device options). Runs as system (platform key) to write the
// kernel's cpu_max_khz parameter, which init hands to the system user.
android_app {
    name: "GtelwifiParts",
    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],
    certificate: "platform",
    platform_apis: true,
    privileged: true,
    system_ext_specific: true,
    static_libs: [
        "androidx.core_core",
        "androidx.preference_preference",
        "SettingsLibCollapsingToolbarBaseActivity",
        "SettingsLibSettingsTheme",
    ],
    optimize: {
        enabled: false,
    },
}
