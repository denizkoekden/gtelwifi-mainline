# TWRP-only entries. Never listed: SBOOT, SBOOT2, PARAM, the modem and NV
# partitions, CSC (second super device, written only as part of super).
# No USB OTG: the dwc2 runs as peripheral only (dr_mode in sc7730.dtsi).
# No /super: TWRP adds it on its own (Setup_Super_Partition, on by-name/SYSTEM),
# a second entry here showed up twice in Backup.
/boot           emmc  /dev/block/by-name/KERNEL    flags=display="Boot";backup=1;flashimg=1
/recovery       emmc  /dev/block/by-name/RECOVERY  flags=display="Recovery";backup=1
/efs            ext4  /dev/block/by-name/efs       flags=display="EFS";backup=1;mounttodecrypt=0
/efs_image      emmc  /dev/block/by-name/efs       flags=display="EFS image";backup=1
/metadata       ext4  /dev/block/by-name/HIDDEN    flags=display="Metadata";backup=1
# microSD: mainline numbers the MMC hosts by the DT aliases, mmc1 is the
# WLAN SDIO, so the card is mmcblk2 (mmcblk1 under the vendor kernel).
/external_sd    auto  /dev/block/mmcblk2p1  /dev/block/mmcblk2  flags=display="Micro SD";storage;wipeingui;removable
