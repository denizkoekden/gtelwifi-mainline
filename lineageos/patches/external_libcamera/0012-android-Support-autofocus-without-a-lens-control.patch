+		resultMetadata->addEntry(ANDROID_CONTROL_AF_STATE,
+					 androidAfState(afMode, afState, afLocked_));
 	}
 
 	if (metadata.contains(controls::draft::LENS_FOCUS_DISTANCE)) {
