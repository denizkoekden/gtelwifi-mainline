 	return resultMetadata;
 }
 
+/*
+ * libcamera reports Idle/Scanning/Focused/Failed. In auto mode, and in a
+ * continuous mode after a trigger, Android expects the locked states that
+ * apps wait for after a tap or before a still.
+ */
+uint8_t CameraDevice::androidAfState(int32_t mode, int32_t state, bool locked)
+{
+	if (mode == controls::AfModeOff || state == controls::AfStateIdle)
+		return ANDROID_CONTROL_AF_STATE_INACTIVE;
+
+	if (mode == controls::AfModeAuto || mode == controls::AfModeMacro || locked) {
+		switch (state) {
+		case controls::AfStateScanning:
+			return ANDROID_CONTROL_AF_STATE_ACTIVE_SCAN;
+		case controls::AfStateFocused:
+			return ANDROID_CONTROL_AF_STATE_FOCUSED_LOCKED;
+		default:
+			return ANDROID_CONTROL_AF_STATE_NOT_FOCUSED_LOCKED;
+		}
+	}
+
+	switch (state) {
+	case controls::AfStateScanning:
+		return ANDROID_CONTROL_AF_STATE_PASSIVE_SCAN;
+	case controls::AfStateFocused:
+		return ANDROID_CONTROL_AF_STATE_PASSIVE_FOCUSED;
+	default:
+		return ANDROID_CONTROL_AF_STATE_PASSIVE_UNFOCUSED;
+	}
+}
+
 std::unique_ptr<CameraMetadata>
 CameraDevice::getPartialResultMetadata(const ControlList &metadata) const
 {
@@ -2204,8 +2239,10 @@ CameraDevice::getPartialResultMetadata(const ControlList &metadata) const
 	}
 
 	if (metadata.contains(controls::AF_STATE)) {
-		const auto &afState = metadata.get(controls::AfState);
-		resultMetadata->addEntry(ANDROID_CONTROL_AF_STATE, afState.value_or(0));
