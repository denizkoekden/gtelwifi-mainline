From a89dfda2a75b93f93dacfbf82a6499a6b4739758 Mon Sep 17 00:00:00 2001
From: Deniz Kokden <koekdendeniz@gmail.com>
Date: Wed, 4 Nov 2026 22:50:31 +0100
Subject: [PATCH] WMShell: no desktop mode without multi-window support

Desktop windows are freeform tasks, and the window manager only creates
those when the device supports multi-window. A low-RAM tablet (Android
Go profile, gtelwifi) whose overlay marks desktop mode as supported got
"Can't create root task for unsupported windowingMode=5" from
RootTaskDesksOrganizer.createDeskRoot, and SystemUI crashed in a loop.
Treat such a device as not eligible for desktop mode.

Assisted-by: Claude Opus 5.5
Change-Id: I2c9b70c4484e17072e1d8ae139815309ef588377
---
 .../wm/shell/shared/desktopmode/DesktopModeStatus.java      | 6 ++++++
 .../android/wm/shell/shared/desktopmode/DesktopStateImpl.kt | 6 ++++++
 2 files changed, 12 insertions(+)

diff --git a/libs/WindowManager/Shell/shared/src/com/android/wm/shell/shared/desktopmode/DesktopModeStatus.java b/libs/WindowManager/Shell/shared/src/com/android/wm/shell/shared/desktopmode/DesktopModeStatus.java
index 06a0977b3bec..c9c50ae6b787 100644
--- a/libs/WindowManager/Shell/shared/src/com/android/wm/shell/shared/desktopmode/DesktopModeStatus.java
+++ b/libs/WindowManager/Shell/shared/src/com/android/wm/shell/shared/desktopmode/DesktopModeStatus.java
@@ -22,6 +22,7 @@ import static com.android.wm.shell.shared.bubbles.BubbleFlagHelper.enableBubbleT
 
 import android.annotation.NonNull;
 import android.annotation.Nullable;
+import android.app.ActivityTaskManager;
 import android.content.Context;
 import android.hardware.display.DisplayManager;
 import android.os.SystemProperties;
@@ -196,6 +197,11 @@ public class DesktopModeStatus {
         if (!enforceDeviceRestrictions()) {
             return true;
         }
+        // Desktop windows are freeform tasks, which the window manager only creates with
+        // multi-window support (off on low-RAM devices, for instance)
+        if (!ActivityTaskManager.supportsMultiWindow(context)) {
+            return false;
+        }
         final boolean desktopModeSupportedByDevOptions =
                 Flags.enableDesktopModeThroughDevOption()
                     && isDesktopModeDevOptionSupported(context);
diff --git a/libs/WindowManager/Shell/shared/src/com/android/wm/shell/shared/desktopmode/DesktopStateImpl.kt b/libs/WindowManager/Shell/shared/src/com/android/wm/shell/shared/desktopmode/DesktopStateImpl.kt
index 4771344e8469..b9e9e550922c 100644
--- a/libs/WindowManager/Shell/shared/src/com/android/wm/shell/shared/desktopmode/DesktopStateImpl.kt
+++ b/libs/WindowManager/Shell/shared/src/com/android/wm/shell/shared/desktopmode/DesktopStateImpl.kt
@@ -16,6 +16,7 @@
 
 package com.android.wm.shell.shared.desktopmode
 
+import android.app.ActivityTaskManager
 import android.content.Context
 import android.content.pm.PackageManager.FEATURE_FREEFORM_WINDOW_MANAGEMENT
 import android.hardware.display.DisplayManager
@@ -47,6 +48,10 @@ class DesktopStateImpl(context: Context) : DesktopState {
     private val isDesktopModeSupported =
         context.getResources().getBoolean(R.bool.config_isDesktopModeSupported)
 
+    // Desktop windows are freeform tasks, which the window manager only creates with
+    // multi-window support (off on low-RAM devices, for instance)
+    private val supportsMultiWindow = ActivityTaskManager.supportsMultiWindow(context)
+
     private val canInternalDisplayHostDesktops =
         context.getResources().getBoolean(R.bool.config_canInternalDisplayHostDesktops)
 
@@ -93,6 +98,7 @@ class DesktopStateImpl(context: Context) : DesktopState {
     override val isDeviceEligibleForDesktopMode: Boolean
         get() {
             if (!enforceDeviceRestrictions) return true
+            if (!supportsMultiWindow) return false
             val desktopModeSupportedByDevOptions =
                 Flags.enableDesktopModeThroughDevOption() && isDesktopModeDevOptionSupported
             return isDesktopModeSupported || desktopModeSupportedByDevOptions
