 	case VSP_HW_INFO:
-		/* Vendor ABI returns AON_APB_EB0, not a VSP register ID. */
-		return put_user(readl(v->aon), (u32 __user *)arg);
+		/* Match the vendor's MM-enabled AON_APB_EB0 snapshot at open. */
+		ret = pm_runtime_resume_and_get(v->dev);
+		if (ret < 0)
+			return ret;
+		value = readl(v->aon);
+		pm_runtime_put_sync(v->dev);
+		return put_user(value, (u32 __user *)arg);
 	case VSP_CAPABILITY:
 		return put_user(2, (u32 __user *)arg); /* SCX30G */
 	case VSP_ALLOC_BUFFER:
 		return vsp_alloc(fh, arg);
+	case VSP_IMPORT_BUFFER:
+		return vsp_import(fh, arg);
+	case VSP_RELEASE_IMPORT:
+		return vsp_release_import(fh, arg);
 	}
 	if (v->owner != fh)
 		return -EPERM;
@@ -281,15 +447,17 @@ static long vsp_ioctl_locked(struct vsp_file *fh, unsigned int cmd,
 		return 0;
 	case VSP_DISABLE:
 	case VSP_RELEASE:
+		vsp_revoke_registers(fh);
 		vsp_quiesce(v);
 		synchronize_irq(v->irq);
 		v->status = 0;
 		v->enabled = false;
 		if (cmd == VSP_RELEASE) {
 			v->owner = NULL;
+			pm_runtime_put_sync(v->dev);
+			pm_relax(v->dev);
 			up(&v->gate);
 		}
-		/* Physical clocks stay on until final close, including VMAs. */
 		return 0;
 	case VSP_RESET:
 		vsp_quiesce(v);
@@ -329,8 +497,15 @@ static long vsp_ioctl(struct file *file, unsigned int cmd, unsigned long arg)
 		if (ret)
 			return ret;
 		mutex_lock(&v->lock);
+		ret = pm_runtime_resume_and_get(v->dev);
+		if (ret < 0) {
+			mutex_unlock(&v->lock);
+			up(&v->gate);
+			return ret;
+		}
 		v->owner = fh;
 		v->status = 0;
+		pm_stay_awake(v->dev);
 		mutex_unlock(&v->lock);
 		return 0;
 	}
@@ -341,6 +516,25 @@ static long vsp_ioctl(struct file *file, unsigned int cmd, unsigned long arg)
 	return ret;
 }
 
+static vm_fault_t vsp_register_fault(struct vm_fault *vmf)
+{
+	struct vsp_file *fh = vmf->vma->vm_private_data;
+	struct sc7730_vsp *v = fh->vsp;
+	vm_fault_t ret = VM_FAULT_SIGBUS;
+
+	mutex_lock(&v->lock);
+	if (v->owner == fh && v->enabled &&
+	    vmf->pgoff < (SPRD_VSP_MAP_SIZE >> PAGE_SHIFT))
+		ret = vmf_insert_pfn(vmf->vma, vmf->address,
+				     (v->phys >> PAGE_SHIFT) + vmf->pgoff);
+	mutex_unlock(&v->lock);
+	return ret;
+}
+
+static const struct vm_operations_struct vsp_register_vm_ops = {
+	.fault = vsp_register_fault,
+};
+
