-	    fh->nbufs == MAX_BUFFERS)
+	    slot == MAX_BUFFERS)
 		return -EINVAL;
 	b.size = PAGE_ALIGN(request.size);
 	if (fh->allocated + b.size > MAX_DMA_BYTES)
@@ -230,16 +285,114 @@ static long vsp_alloc(struct vsp_file *fh, void __user *arg)
 		return -ENOMEM;
 	request.size = b.size;
 	request.dma_addr = b.dma;
-	request.mmap_offset = BUFFER_BASE + fh->nbufs * BUFFER_STEP;
+	request.mmap_offset = BUFFER_BASE + slot * BUFFER_STEP;
 	if (copy_to_user(arg, &request, sizeof(request))) {
 		dma_free_coherent(v->dev, b.size, b.cpu, b.dma);
 		return -EFAULT;
 	}
-	fh->bufs[fh->nbufs++] = b;
+	fh->bufs[slot] = b;
+	fh->nbufs = max(fh->nbufs, slot + 1);
 	fh->allocated += b.size;
 	return 0;
 }
 
+static long vsp_import(struct vsp_file *fh, void __user *arg)
+{
+	struct sc7730_vsp *v = fh->vsp;
+	struct sprd_vsp_import request;
+	struct vsp_buffer b = {};
+	struct scatterlist *sg;
+	size_t span = 0;
+	unsigned int i, slot = vsp_free_slot(fh);
+	int ret;
+
+	if (copy_from_user(&request, arg, sizeof(request)))
+		return -EFAULT;
+	if (request.buffer_id || slot == MAX_BUFFERS)
+		return -EINVAL;
+	b.dmabuf = dma_buf_get(request.fd);
+	if (IS_ERR(b.dmabuf))
+		return PTR_ERR(b.dmabuf);
+	b.size = b.dmabuf->size;
+	if (!b.size || b.size > BUFFER_STEP ||
+	    fh->allocated + b.size > MAX_DMA_BYTES) {
+		ret = -EINVAL;
+		goto put;
+	}
+	b.attachment = dma_buf_attach(b.dmabuf, v->dev);
+	if (IS_ERR(b.attachment)) {
+		ret = PTR_ERR(b.attachment);
+		goto put;
+	}
+	b.sgt = dma_buf_map_attachment_unlocked(b.attachment, DMA_BIDIRECTIONAL);
+	if (IS_ERR(b.sgt)) {
+		ret = PTR_ERR(b.sgt);
+		goto detach;
+	}
+	if (!b.sgt->nents || !b.sgt->sgl) {
+		ret = -EINVAL;
+		goto unmap;
+	}
+	b.dma = sg_dma_address(b.sgt->sgl);
+	for_each_sgtable_dma_sg(b.sgt, sg, i) {
+		if (sg_dma_address(sg) != b.dma + span) {
+			ret = -EINVAL;
+			goto unmap;
+		}
+		span += sg_dma_len(sg);
+	}
+	if (span < b.size || b.dma > U32_MAX - (b.size - 1)) {
+		ret = -EINVAL;
+		goto unmap;
+	}
+	if (fh->next_id == U32_MAX) {
+		ret = -ENOSPC;
+		goto unmap;
+	}
+	b.id = ++fh->next_id;
+	request.buffer_id = b.id;
+	request.dma_addr = b.dma;
+	request.size = b.size;
+	if (copy_to_user(arg, &request, sizeof(request))) {
+		ret = -EFAULT;
+		goto unmap;
+	}
+	fh->bufs[slot] = b;
+	fh->nbufs = max(fh->nbufs, slot + 1);
+	fh->allocated += b.size;
+	return 0;
+unmap:
+	dma_buf_unmap_attachment_unlocked(b.attachment, b.sgt, DMA_BIDIRECTIONAL);
+detach:
+	dma_buf_detach(b.dmabuf, b.attachment);
+put:
+	dma_buf_put(b.dmabuf);
+	return ret;
+}
+
+static long vsp_release_import(struct vsp_file *fh, void __user *arg)
+{
+	u32 id;
+	unsigned int i;
+
+	if (get_user(id, (u32 __user *)arg))
+		return -EFAULT;
+	if (!id)
+		return -EINVAL;
+	if (fh->vsp->owner)
+		return -EBUSY;
+	for (i = 0; i < fh->nbufs; i++) {
+		struct vsp_buffer *b = &fh->bufs[i];
+
+		if (b->dmabuf && b->id == id) {
+			fh->allocated -= b->size;
+			vsp_unimport(b);
+			return 0;
+		}
+	}
+	return -ENOENT;
+}
+
 static long vsp_ioctl_locked(struct vsp_file *fh, unsigned int cmd,
 			     void __user *arg)
 {
@@ -249,29 +402,42 @@ static long vsp_ioctl_locked(struct vsp_file *fh, unsigned int cmd,
 	long ret;
 
 	if (v->owner && v->owner != fh &&
-	    cmd != VSP_ALLOC_BUFFER && cmd != VSP_HW_INFO &&
+	    cmd != VSP_ALLOC_BUFFER && cmd != VSP_IMPORT_BUFFER &&
