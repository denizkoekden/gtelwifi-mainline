+
+		if (!b->size)
+			continue;
+		if (b->dmabuf)
+			vsp_unimport(b);
+		else
+			dma_free_coherent(v->dev, b->size, b->cpu, b->dma);
+	}
+	v->users--;
 	mutex_unlock(&v->lock);
 	kfree(fh);
 	return 0;
@@ -215,12 +269,13 @@ static long vsp_alloc(struct vsp_file *fh, void __user *arg)
 {
 	struct sc7730_vsp *v = fh->vsp;
 	struct sprd_vsp_buffer request;
-	struct vsp_buffer b;
+	struct vsp_buffer b = {};
+	unsigned int slot = vsp_free_slot(fh);
 
 	if (copy_from_user(&request, arg, sizeof(request)))
 		return -EFAULT;
