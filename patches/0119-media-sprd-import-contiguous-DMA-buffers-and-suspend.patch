+/* Apply policy only at the next CONFIG_FREQ, never during a running job. */
+static unsigned int max_freq_level = 3;
+
+static int vsp_set_max_freq_level(const char *val, const struct kernel_param *kp)
+{
+	unsigned int level;
+	int ret = kstrtouint(val, 0, &level);
+
+	if (ret)
