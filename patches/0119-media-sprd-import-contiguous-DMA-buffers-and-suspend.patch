+
+static void vsp_revoke_registers(struct vsp_file *fh)
+{
+	fh->vsp->enabled = false;
+	/* Only offset 0 is MMIO. CMA VMAs retain their original high offsets. */
+	unmap_mapping_range(fh->mapping, 0, SPRD_VSP_MAP_SIZE, 1);
+}
+
+static void vsp_unimport(struct vsp_buffer *b)
+{
+	dma_buf_unmap_attachment_unlocked(b->attachment, b->sgt, DMA_BIDIRECTIONAL);
+	dma_buf_detach(b->dmabuf, b->attachment);
+	dma_buf_put(b->dmabuf);
+	memset(b, 0, sizeof(*b));
+}
+
+static unsigned int vsp_free_slot(struct vsp_file *fh)
+{
+	unsigned int i;
+
+	for (i = 0; i < MAX_BUFFERS; i++)
+		if (!fh->bufs[i].size)
+			return i;
+	return MAX_BUFFERS;
 }
 
 static int vsp_close(struct inode *inode, struct file *file)
@@ -191,21 +240,26 @@ static int vsp_close(struct inode *inode, struct file *file)
 
 	mutex_lock(&v->lock);
 	/* An allocator fd must outlive every decoder using its buffers. */
-	if (v->owner == fh || fh->nbufs) {
