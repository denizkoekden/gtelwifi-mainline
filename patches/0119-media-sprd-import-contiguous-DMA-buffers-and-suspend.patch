+	    cmd != VSP_HW_INFO &&
 	    cmd != VSP_CAPABILITY && cmd != VSP_GET_FREQ)
 		return -EPERM;
 	switch (cmd) {
 	case VSP_CONFIG_FREQ:
+		if (v->owner != fh)
+			return -EPERM;
 		if (get_user(value, (u32 __user *)arg))
