@@ -0,0 +1,27 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/media/sprd,sc7730-mm-ahb.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Spreadtrum SC7730 multimedia AHB system controller
+
+maintainers:
+  - Deniz Kokden <koekdendeniz@gmail.com>
+
+description: |
+  Shared clock gates, resets and CSI selection for DCAM, CSI, VSP and
+  other multimedia engines. Consumers must power the MM domain before
+  accessing these registers.
+
+properties:
+  compatible:
+    items:
+      - const: sprd,sc7730-mm-ahb
+      - const: syscon
+  reg:
+    maxItems: 1
+required:
+  - compatible
+  - reg
+additionalProperties: false
diff --git a/Documentation/devicetree/bindings/media/sprd,sc7730-vsp.yaml b/Documentation/devicetree/bindings/media/sprd,sc7730-vsp.yaml
new file mode 100644
index 000000000..c4f22c16f
--- /dev/null
+++ b/Documentation/devicetree/bindings/media/sprd,sc7730-vsp.yaml
@@ -0,0 +1,60 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/media/sprd,sc7730-vsp.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Spreadtrum SC7730 video signal processor
+
+maintainers:
+  - Deniz Kokden <koekdendeniz@gmail.com>
+
+description: |
+  The VSP is a register-programmed video decoder in the MM power domain.
+  Its bus gates and reset share the MM AHB syscon with the camera. Clock
+  configuration and AON APB are shared windows, as in the DCAM binding.
+  The VSP clock mux selects TDPLL-derived 76.8, 128, 192 or 256 MHz.
+
+properties:
+  compatible:
+    const: sprd,sc7730-vsp
+  reg:
+    items:
+      - description: VSP register window
+      - description: MM clock registers
+      - description: AON APB registers
+  reg-names:
+    items:
+      - const: vsp
+      - const: mm-clk
+      - const: aon-apb
+  sprd,mm-ahb:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: Shared MM AHB syscon for clock gates and reset.
+  interrupts:
+    maxItems: 1
+  power-domains:
+    maxItems: 1
+
+required:
+  - compatible
+  - reg
+  - reg-names
+  - sprd,mm-ahb
+  - interrupts
+  - power-domains
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/interrupt-controller/arm-gic.h>
+    video-codec@60900000 {
+        compatible = "sprd,sc7730-vsp";
+        reg = <0x60900000 0xc000>, <0x60e00000 0x100>,
+              <0x402e0000 0x100>;
+        reg-names = "vsp", "mm-clk", "aon-apb";
+        sprd,mm-ahb = <&mm_ahb>;
+        interrupts = <GIC_SPI 43 IRQ_TYPE_LEVEL_HIGH>;
+        power-domains = <&pmu_domains 1>;
+    };
