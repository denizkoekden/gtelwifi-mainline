diff --git a/drivers/media/platform/sprd/sc7730-vsp.c b/drivers/media/platform/sprd/sc7730-vsp.c
new file mode 100644
index 000000000..e85b0bcf3
--- /dev/null
+++ b/drivers/media/platform/sprd/sc7730-vsp.c
@@ -0,0 +1,483 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* SC7730 VSP register/IRQ bridge for the SCX35 decoder ABI.
+ *
+ * This is a privileged bring-up interface, not a V4L2 decoder. Userspace
+ * programs DMA addresses directly. Keep the device root-only. A single
+ * acquisition owns the engine; an mmap holds its file and power domain.
+ */
+#include <linux/capability.h>
+#include <linux/delay.h>
+#include <linux/dma-mapping.h>
+#include <linux/interrupt.h>
+#include <linux/io.h>
+#include <linux/mfd/syscon.h>
+#include <linux/miscdevice.h>
+#include <linux/mm.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/pm_runtime.h>
+#include <linux/pm_wakeup.h>
+#include <linux/regmap.h>
+#include <linux/slab.h>
+#include <linux/semaphore.h>
+#include <linux/sizes.h>
+#include <linux/spinlock.h>
+#include <linux/uaccess.h>
+#include <linux/wait.h>
+#include <uapi/linux/sprd_vsp.h>
+
+#define MM_EB 0x00
+#define MM_RST 0x04
+#define MM_CKG 0x08
+#define EB_VSP BIT(3)
+#define EB_CKG BIT(6)
+#define RST_VSP BIT(4)
+#define CKG_VSP BIT(5)
+#define CKG_AXI BIT(7)
+#define CLK_AHB 0x20
+#define CLK_VSP 0x30
+#define ARM_STS 0x10
+#define ARM_MASK 0x14
+#define ARM_CLR 0x18
+#define GLB_STS 0x1000
+#define GLB_MASK 0x1004
+#define GLB_CLR 0x1008
+#define GLB_IRQS (BIT(1) | BIT(2) | BIT(4) | BIT(5))
+#define ARM_IRQS GENMASK(2, 0)
+#define BUFFER_BASE 0x10000000U
+#define BUFFER_STEP SZ_16M
+#define MAX_BUFFERS 32
+#define MAX_DMA_BYTES (96 * SZ_1M)
+
+struct vsp_buffer {
+	void *cpu;
+	dma_addr_t dma;
+	size_t size;
+};
+
+struct vsp_file;
+
+struct sc7730_vsp {
+	struct device *dev;
+	struct miscdevice misc;
+	struct regmap *mm;
+	void __iomem *regs, *clk, *aon;
+	phys_addr_t phys;
+	struct mutex lock;
+	spinlock_t irq_lock;
+	wait_queue_head_t wait;
+	unsigned int users;
+	struct semaphore gate;
+	struct vsp_file *owner;
+	bool enabled;
+	u32 status, freq;
+	int irq;
+};
+
+struct vsp_file {
+	struct sc7730_vsp *vsp;
+	unsigned int nbufs;
+	size_t allocated;
+	struct vsp_buffer bufs[MAX_BUFFERS];
+};
+
+static void vsp_set_freq(struct sc7730_vsp *v)
+{
+	u32 value = readl(v->clk + CLK_VSP);
+
+	writel((value & ~3U) | (3 - v->freq), v->clk + CLK_VSP);
+}
+
+static void vsp_reset(struct sc7730_vsp *v)
+{
+	regmap_update_bits(v->mm, MM_RST, RST_VSP, RST_VSP);
+	udelay(2);
+	regmap_update_bits(v->mm, MM_RST, RST_VSP, 0);
+}
+
+static void vsp_quiesce(struct sc7730_vsp *v)
+{
+	writel(0, v->regs + GLB_MASK);
+	writel(0, v->regs + ARM_MASK);
+	vsp_reset(v);
+	writel(GLB_IRQS, v->regs + GLB_CLR);
+	writel(ARM_IRQS, v->regs + ARM_CLR);
+}
+
+static irqreturn_t vsp_irq(int irq, void *data)
+{
+	struct sc7730_vsp *v = data;
+	u32 glb = readl(v->regs + GLB_STS) & GLB_IRQS;
+	u32 arm = readl(v->regs + ARM_STS) & ARM_IRQS;
+
+	if (!glb && !arm)
+		return IRQ_NONE;
+	writel(glb, v->regs + GLB_CLR);
+	writel(arm, v->regs + ARM_CLR);
+	spin_lock(&v->irq_lock);
+	/* The legacy library expects VSP bits, or 0xff for ARM-only IRQs. */
+	v->status |= glb ? glb : 0xff;
+	spin_unlock(&v->irq_lock);
+	wake_up_interruptible(&v->wait);
+	return IRQ_HANDLED;
+}
+
+static int vsp_resume(struct device *dev)
+{
+	struct sc7730_vsp *v = dev_get_drvdata(dev);
+	int ret;
+
+	/* genpd powered MM before this callback; no MM reads before here. */
+	ret = regmap_update_bits(v->mm, MM_EB, EB_CKG | EB_VSP,
+				EB_CKG | EB_VSP);
+	if (ret)
+		return ret;
+	regmap_update_bits(v->mm, MM_CKG, CKG_AXI | CKG_VSP,
+			   CKG_AXI | CKG_VSP);
+	writel(3, v->clk + CLK_AHB); /* TDPLL / 5, same as DCAM */
+	vsp_set_freq(v);
+	vsp_quiesce(v);
+	enable_irq(v->irq);
+	return 0;
+}
+
+static int vsp_suspend(struct device *dev)
+{
+	struct sc7730_vsp *v = dev_get_drvdata(dev);
+
+	disable_irq(v->irq);
+	vsp_quiesce(v);
+	regmap_update_bits(v->mm, MM_CKG, CKG_VSP, 0);
+	regmap_update_bits(v->mm, MM_EB, EB_VSP, 0);
+	/* Leave shared CKG/AXI gates to genpd; DCAM may still be active. */
+	return 0;
+}
+
+static int vsp_open(struct inode *inode, struct file *file)
+{
+	struct sc7730_vsp *v = container_of(file->private_data,
+					  struct sc7730_vsp, misc);
+	struct vsp_file *fh;
+	int ret;
+
+	if (!capable(CAP_SYS_RAWIO))
+		return -EPERM;
+	fh = kzalloc_obj(*fh);
+	if (!fh)
+		return -ENOMEM;
+	mutex_lock(&v->lock);
+	ret = pm_runtime_resume_and_get(v->dev);
+	if (ret < 0) {
+		kfree(fh);
+		goto out;
+	}
+	if (!v->users++)
+		pm_stay_awake(v->dev);
+	fh->vsp = v;
+	file->private_data = fh;
+	ret = 0;
+out:
+	mutex_unlock(&v->lock);
+	return ret;
+}
+
+static int vsp_close(struct inode *inode, struct file *file)
+{
+	struct vsp_file *fh = file->private_data;
+	struct sc7730_vsp *v = fh->vsp;
+	unsigned int i;
+
+	mutex_lock(&v->lock);
+	/* An allocator fd must outlive every decoder using its buffers. */
+	if (v->owner == fh || fh->nbufs) {
+		vsp_quiesce(v);
+		synchronize_irq(v->irq);
+	}
+	if (v->owner == fh) {
+		v->owner = NULL;
+		v->enabled = false;
+		up(&v->gate);
+	}
+	for (i = 0; i < fh->nbufs; i++)
+		dma_free_coherent(v->dev, fh->bufs[i].size,
+				  fh->bufs[i].cpu, fh->bufs[i].dma);
+	pm_runtime_put_sync(v->dev);
+	if (!--v->users)
+		pm_relax(v->dev);
+	mutex_unlock(&v->lock);
+	kfree(fh);
+	return 0;
+}
+
+static long vsp_alloc(struct vsp_file *fh, void __user *arg)
+{
+	struct sc7730_vsp *v = fh->vsp;
+	struct sprd_vsp_buffer request;
+	struct vsp_buffer b;
+
+	if (copy_from_user(&request, arg, sizeof(request)))
+		return -EFAULT;
+	if (request.reserved || !request.size || request.size > BUFFER_STEP ||
+	    fh->nbufs == MAX_BUFFERS)
+		return -EINVAL;
+	b.size = PAGE_ALIGN(request.size);
+	if (fh->allocated + b.size > MAX_DMA_BYTES)
+		return -ENOMEM;
+	b.cpu = dma_alloc_coherent(v->dev, b.size, &b.dma, GFP_KERNEL);
+	if (!b.cpu)
+		return -ENOMEM;
+	request.size = b.size;
+	request.dma_addr = b.dma;
+	request.mmap_offset = BUFFER_BASE + fh->nbufs * BUFFER_STEP;
+	if (copy_to_user(arg, &request, sizeof(request))) {
+		dma_free_coherent(v->dev, b.size, b.cpu, b.dma);
+		return -EFAULT;
+	}
+	fh->bufs[fh->nbufs++] = b;
+	fh->allocated += b.size;
+	return 0;
+}
+
+static long vsp_ioctl_locked(struct vsp_file *fh, unsigned int cmd,
+			     void __user *arg)
+{
+	struct sc7730_vsp *v = fh->vsp;
+	unsigned long flags;
+	u32 value;
+	long ret;
+
+	if (v->owner && v->owner != fh &&
+	    cmd != VSP_ALLOC_BUFFER && cmd != VSP_HW_INFO &&
+	    cmd != VSP_CAPABILITY && cmd != VSP_GET_FREQ)
+		return -EPERM;
+	switch (cmd) {
+	case VSP_CONFIG_FREQ:
+		if (get_user(value, (u32 __user *)arg))
+			return -EFAULT;
+		if (value > 3)
+			return -EINVAL;
+		if (v->enabled)
+			return -EBUSY;
+		v->freq = value;
+		vsp_set_freq(v);
+		return 0;
+	case VSP_GET_FREQ:
+		return put_user(v->freq, (u32 __user *)arg);
+	case VSP_HW_INFO:
+		/* Vendor ABI returns AON_APB_EB0, not a VSP register ID. */
+		return put_user(readl(v->aon), (u32 __user *)arg);
+	case VSP_CAPABILITY:
+		return put_user(2, (u32 __user *)arg); /* SCX30G */
+	case VSP_ALLOC_BUFFER:
+		return vsp_alloc(fh, arg);
+	}
+	if (v->owner != fh)
+		return -EPERM;
+	switch (cmd) {
+	case VSP_ENABLE:
+		v->enabled = true;
+		return 0;
+	case VSP_DISABLE:
+	case VSP_RELEASE:
+		vsp_quiesce(v);
+		synchronize_irq(v->irq);
+		v->status = 0;
+		v->enabled = false;
+		if (cmd == VSP_RELEASE) {
+			v->owner = NULL;
+			up(&v->gate);
+		}
+		/* Physical clocks stay on until final close, including VMAs. */
+		return 0;
+	case VSP_RESET:
+		vsp_quiesce(v);
+		synchronize_irq(v->irq);
+		v->status = 0;
+		return 0;
+	case VSP_COMPLETE:
+		if (!v->enabled)
+			return -EPERM;
+		ret = wait_event_interruptible_timeout(v->wait,
+				READ_ONCE(v->status), msecs_to_jiffies(200));
+		spin_lock_irqsave(&v->irq_lock, flags);
+		value = v->status;
+		v->status = 0;
+		spin_unlock_irqrestore(&v->irq_lock, flags);
+		if (ret <= 0) {
+			value |= ret ? BIT(30) : BIT(31);
+			vsp_quiesce(v);
+		}
+		if (put_user(value, (u32 __user *)arg))
+			return -EFAULT;
+		return ret > 0 ? 0 : ret < 0 ? -EINVAL : -ETIMEDOUT;
+	default:
+		return -ENOTTY;
+	}
+}
+
+static long vsp_ioctl(struct file *file, unsigned int cmd, unsigned long arg)
+{
+	struct vsp_file *fh = file->private_data;
+	struct sc7730_vsp *v = fh->vsp;
+	long ret;
+
+	/* Never wait for ownership with lock held: RELEASE needs the lock. */
+	if (cmd == VSP_ACQUAIRE) {
+		ret = down_timeout(&v->gate, msecs_to_jiffies(500));
+		if (ret)
+			return ret;
+		mutex_lock(&v->lock);
+		v->owner = fh;
+		v->status = 0;
+		mutex_unlock(&v->lock);
+		return 0;
+	}
+	if (mutex_lock_interruptible(&v->lock))
+		return -ERESTARTSYS;
+	ret = vsp_ioctl_locked(fh, cmd, (void __user *)arg);
+	mutex_unlock(&v->lock);
+	return ret;
+}
+
+static int vsp_mmap(struct file *file, struct vm_area_struct *vma)
+{
+	struct vsp_file *fh = file->private_data;
+	struct sc7730_vsp *v = fh->vsp;
+	unsigned long offset = vma->vm_pgoff << PAGE_SHIFT;
+	unsigned long size = vma->vm_end - vma->vm_start;
+	unsigned int slot;
+	int ret = -EINVAL;
+
+	if (vma->vm_pgoff > (U32_MAX >> PAGE_SHIFT) ||
+	    !(vma->vm_flags & VM_SHARED) || vma->vm_flags & VM_EXEC)
+		return -EINVAL;
+	mutex_lock(&v->lock);
+	vm_flags_clear(vma, VM_MAYEXEC);
+	vm_flags_set(vma, VM_DONTEXPAND | VM_DONTDUMP | VM_DONTCOPY);
+	if (!vma->vm_pgoff && size <= SPRD_VSP_MAP_SIZE) {
+		vma->vm_page_prot = pgprot_noncached(vma->vm_page_prot);
+		ret = io_remap_pfn_range(vma, vma->vm_start,
+					v->phys >> PAGE_SHIFT, size,
+					vma->vm_page_prot);
+	} else if (offset >= BUFFER_BASE &&
+		   !((offset - BUFFER_BASE) % BUFFER_STEP)) {
+		slot = (offset - BUFFER_BASE) / BUFFER_STEP;
+		if (slot < fh->nbufs && size == fh->bufs[slot].size) {
+			vma->vm_pgoff = 0;
+			ret = dma_mmap_coherent(v->dev, vma, fh->bufs[slot].cpu,
+						fh->bufs[slot].dma, size);
+		}
+	}
+	mutex_unlock(&v->lock);
+	return ret;
+}
+
+static const struct file_operations vsp_fops = {
+	.owner = THIS_MODULE,
+	.open = vsp_open,
+	.release = vsp_close,
+	.unlocked_ioctl = vsp_ioctl,
+	.mmap = vsp_mmap,
+	.llseek = noop_llseek,
+};
+
+static int vsp_system_suspend(struct device *dev)
+{
+	struct sc7730_vsp *v = dev_get_drvdata(dev);
+	int ret;
+
+	mutex_lock(&v->lock);
+	ret = v->users ? -EBUSY : 0;
+	mutex_unlock(&v->lock);
+	return ret;
+}
+
+static const struct dev_pm_ops vsp_pm = {
+	RUNTIME_PM_OPS(vsp_suspend, vsp_resume, NULL)
+	.suspend = vsp_system_suspend,
+};
+
+static int vsp_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct sc7730_vsp *v;
+	struct resource *res;
+	int ret;
+
+	v = devm_kzalloc(dev, sizeof(*v), GFP_KERNEL);
+	if (!v)
+		return -ENOMEM;
+	v->dev = dev;
+	mutex_init(&v->lock);
+	sema_init(&v->gate, 1);
+	spin_lock_init(&v->irq_lock);
+	init_waitqueue_head(&v->wait);
+	res = platform_get_resource_byname(pdev, IORESOURCE_MEM, "vsp");
+	if (!res || resource_size(res) < 0xc000)
+		return -EINVAL;
+	v->phys = res->start;
+	v->regs = devm_ioremap_resource(dev, res);
+	if (IS_ERR(v->regs))
+		return PTR_ERR(v->regs);
+	/* Shared clock/AON windows, only our own mux is written. */
+	res = platform_get_resource_byname(pdev, IORESOURCE_MEM, "mm-clk");
+	if (!res)
+		return -EINVAL;
+	v->clk = devm_ioremap(dev, res->start, resource_size(res));
+	res = platform_get_resource_byname(pdev, IORESOURCE_MEM, "aon-apb");
+	if (!res)
+		return -EINVAL;
+	v->aon = devm_ioremap(dev, res->start, resource_size(res));
+	if (!v->clk || !v->aon)
+		return -ENOMEM;
+	v->mm = syscon_regmap_lookup_by_phandle(dev->of_node, "sprd,mm-ahb");
+	if (IS_ERR(v->mm))
+		return dev_err_probe(dev, PTR_ERR(v->mm), "MM AHB syscon\n");
+	ret = dma_set_mask_and_coherent(dev, DMA_BIT_MASK(32));
+	if (ret)
+		return ret;
+	v->irq = platform_get_irq(pdev, 0);
+	if (v->irq < 0)
+		return v->irq;
+	ret = devm_request_irq(dev, v->irq, vsp_irq, IRQF_NO_AUTOEN,
+			       dev_name(dev), v);
+	if (ret)
+		return ret;
+	platform_set_drvdata(pdev, v);
+	ret = device_init_wakeup(dev, true);
+	if (ret)
+		return ret;
+	pm_runtime_set_suspended(dev);
+	pm_runtime_enable(dev);
+	v->misc.minor = MISC_DYNAMIC_MINOR;
+	v->misc.name = "sprd_vsp";
+	v->misc.fops = &vsp_fops;
+	v->misc.parent = dev;
+	v->misc.mode = 0600;
+	ret = misc_register(&v->misc);
+	if (ret) {
+		pm_runtime_disable(dev);
+		device_init_wakeup(dev, false);
+	}
+	return ret;
+}
+
+static const struct of_device_id vsp_of_match[] = {
+	{ .compatible = "sprd,sc7730-vsp" },
+	{ }
+};
+
+static struct platform_driver vsp_driver = {
+	.probe = vsp_probe,
+	.driver = {
+		.name = "sc7730-vsp",
+		.of_match_table = vsp_of_match,
+		.pm = pm_ptr(&vsp_pm),
+		.suppress_bind_attrs = true,
+	},
+};
+builtin_platform_driver(vsp_driver);
+MODULE_DESCRIPTION("SC7730 VSP privileged register and IRQ bridge");
+MODULE_LICENSE("GPL");
