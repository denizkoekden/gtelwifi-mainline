From 08be76a7ad95a3a815f28ddca293af97df4a2ec2 Mon Sep 17 00:00:00 2001
From: Deniz Kokden <koekdendeniz@gmail.com>
Date: Sat, 7 Nov 2026 12:14:00 +0000
Subject: [PATCH 112/127] Input: zinitix - optional report timing diagnostics

Add a ts_debug parameter (default off) that logs the chip time stamp,
the IRQ spacing and the handler time of every report. Measured on the
SM-T560: 80.6 Hz reports, 5.0 ms handler time at 100 kHz I2C.

Assisted-by: Claude Opus 5.5
---
 drivers/input/touchscreen/zinitix.c | 18 ++++++++++++++++++
 1 file changed, 18 insertions(+)

diff --git a/drivers/input/touchscreen/zinitix.c b/drivers/input/touchscreen/zinitix.c
index 0c36765bd..52a6865dc 100644
--- a/drivers/input/touchscreen/zinitix.c
+++ b/drivers/input/touchscreen/zinitix.c
@@ -8,6 +8,7 @@
 #include <linux/interrupt.h>
 #include <linux/irq.h>
 #include <linux/kernel.h>
+#include <linux/ktime.h>
 #include <linux/module.h>
 #include <linux/of.h>
 #include <linux/property.h>
@@ -165,8 +166,14 @@ struct bt541_ts_data {
 	u16 firmware_version;
 	u16 regdata_version;
 	u16 icon_status_reg;
+	ktime_t last_irq;
 };
 
+static bool ts_debug;
+module_param(ts_debug, bool, 0644);
+MODULE_PARM_DESC(ts_debug,
+		 "log chip time stamp, IRQ spacing and handler time of every report");
+
 static int zinitix_read_data(struct i2c_client *client,
 			     u16 reg, void *values, size_t length)
 {
@@ -447,6 +454,7 @@ static irqreturn_t zinitix_ts_irq_handler(int irq, void *bt541_handler)
 	struct touch_event touch_event;
 	unsigned long finger_mask;
 	__le16 icon_events;
+	ktime_t t0 = ktime_get();
 	int error;
 	int i;
 
@@ -484,6 +492,16 @@ static irqreturn_t zinitix_ts_irq_handler(int irq, void *bt541_handler)
 
 out:
 	zinitix_write_cmd(bt541->client, ZINITIX_CLEAR_INT_STATUS_CMD);
+
+	if (ts_debug) {
+		dev_info(&client->dev,
+			 "report: chip ts %u status %#x fingers %#x irq_gap %lld us handler %lld us\n",
+			 touch_event.time_stamp, le16_to_cpu(touch_event.status),
+			 touch_event.finger_mask,
+			 ktime_us_delta(t0, bt541->last_irq),
+			 ktime_us_delta(ktime_get(), t0));
+		bt541->last_irq = t0;
+	}
 	return IRQ_HANDLED;
 }
 
