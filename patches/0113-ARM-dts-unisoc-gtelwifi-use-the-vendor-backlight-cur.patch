From 7633905625f930da005c11251477617aac79b784 Mon Sep 17 00:00:00 2001
From: Deniz Kokden <koekdendeniz@gmail.com>
Date: Sat, 7 Nov 2026 18:54:27 +0000
Subject: [PATCH 113/115] ARM: dts: unisoc: gtelwifi: use the vendor backlight
 curve

The linear 0..255 ramp left the lowest brightness levels below the PWM
duty at which the RT8555 LED driver lights the panel: with the Android
slider at its minimum the screen went black and the slider could no
longer be found. Use the curve of the vendor device tree
(backlight-brt-range in sprd-scx35_gtelwifi_rev10.dts, mapped as in
sprd_pwm_bl.c): levels 1-5 give duty 3, 10 gives 14, 162 gives 122 (the
vendor default, now the default level), 255 gives 255, linear in between.

Assisted-by: Claude Opus 5.5
---
 .../dts/unisoc/sc7730-samsung-gtelwifi.dts    | 29 +++++++++++++++++--
 1 file changed, 26 insertions(+), 3 deletions(-)

diff --git a/arch/arm/boot/dts/unisoc/sc7730-samsung-gtelwifi.dts b/arch/arm/boot/dts/unisoc/sc7730-samsung-gtelwifi.dts
index 63430ddc9..7803fbb42 100644
--- a/arch/arm/boot/dts/unisoc/sc7730-samsung-gtelwifi.dts
+++ b/arch/arm/boot/dts/unisoc/sc7730-samsung-gtelwifi.dts
@@ -412,9 +412,32 @@ gps-power {
 	backlight: backlight {
 		compatible = "pwm-backlight";
 		pwms = <&pwm 3 49039 0>;
-		brightness-levels = <0 255>;
-		num-interpolated-steps = <255>;
-		default-brightness-level = <143>;
+		/*
+		 * Vendor curve (sprd-scx35_gtelwifi_rev10.dts backlight-brt-range,
+		 * sprd_pwm_bl.c): 0 off, 1-5 -> duty 3 (MIN), 10 -> 14 (DIM),
+		 * 162 -> 122 (DEF), 255 -> 255, linear in between. A plain 0..255
+		 * ramp left the lowest Android levels below the duty at which the
+		 * RT8555 LED driver lights the panel (screen black at minimum).
+		 */
+		brightness-levels = <
+			  0   3   3   3   3   3   6   8  10  12  14  15  16  17  17  18
+			 19  19  20  21  22  22  23  24  24  25  26  27  27  28  29  29
+			 30  31  32  32  33  34  34  35  36  37  37  38  39  39  40  41
+			 41  42  43  44  44  45  46  46  47  48  49  49  50  51  51  52
+			 53  54  54  55  56  56  57  58  59  59  60  61  61  62  63  64
+			 64  65  66  66  67  68  68  69  70  71  71  72  73  73  74  75
+			 76  76  77  78  78  79  80  81  81  82  83  83  84  85  86  86
+			 87  88  88  89  90  91  91  92  93  93  94  95  95  96  97  98
+			 98  99 100 100 101 102 103 103 104 105 105 106 107 108 108 109
+			110 110 111 112 113 113 114 115 115 116 117 118 118 119 120 120
+			121 122 122 124 125 127 128 130 131 133 134 135 137 138 140 141
+			143 144 145 147 148 150 151 153 154 155 157 158 160 161 163 164
+			165 167 168 170 171 173 174 175 177 178 180 181 183 184 185 187
+			188 190 191 193 194 195 197 198 200 201 203 204 205 207 208 210
+			211 213 214 215 217 218 220 221 223 224 225 227 228 230 231 233
+			234 235 237 238 240 241 243 244 245 247 248 250 251 253 254 255
+		>;
+		default-brightness-level = <162>;
 	};
 };
 
