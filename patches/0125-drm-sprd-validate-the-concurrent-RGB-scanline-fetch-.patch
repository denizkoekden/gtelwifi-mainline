From 1e02d84e9818f3db104ac7feec89c14891ffba48 Mon Sep 17 00:00:00 2001
From: Deniz Kokden <koekdendeniz@gmail.com>
Date: Mon, 9 Nov 2026 15:42:43 +0000
Subject: [PATCH 125/127] drm/sprd: validate the concurrent RGB scanline fetch
 budget

Reject overlapping RGB plans that exceed one full display-width RGBA
scanline of fetches. Full-width dual RGB planes underrun under normal
GPU load even with separated source addresses; narrow or vertically
disjoint plans passed the same load test. Include both plane states in
TEST_ONLY validation so the composer can choose client composition.

Assisted-by: GPT-6 (Codex)
---
 drivers/gpu/drm/sprd/sprd_dispc.c | 39 ++++++++++++++++++++++++++++++-
 1 file changed, 38 insertions(+), 1 deletion(-)

diff --git a/drivers/gpu/drm/sprd/sprd_dispc.c b/drivers/gpu/drm/sprd/sprd_dispc.c
index afa5f64f8..1760ad05f 100644
--- a/drivers/gpu/drm/sprd/sprd_dispc.c
+++ b/drivers/gpu/drm/sprd/sprd_dispc.c
@@ -752,9 +752,46 @@ static const struct drm_mode_config_helper_funcs sprd_dispc_mode_config_helpers
 	.atomic_commit_tail = drm_atomic_helper_commit_tail_rpm,
 };
 
+static int sprd_dispc_atomic_check(struct drm_device *drm,
+				 struct drm_atomic_commit *state)
+{
+	struct sprd_dispc *d = to_sprd_dispc(drm);
+	struct drm_plane_state *img, *osd;
+	int ret;
+
+	/* Include both planes so TEST_ONLY sees the complete fetch workload. */
+	img = drm_atomic_get_plane_state(state, &d->img_plane);
+	if (IS_ERR(img))
+		return PTR_ERR(img);
+	osd = drm_atomic_get_plane_state(state, &d->plane);
+	if (IS_ERR(osd))
+		return PTR_ERR(osd);
+
+	ret = drm_atomic_helper_check(drm, state);
+	if (ret)
+		return ret;
+	if (!img->visible || !osd->visible || img->crtc != osd->crtc)
+		return 0;
+	if (img->crtc_y + img->crtc_h <= osd->crtc_y ||
+	    osd->crtc_y + osd->crtc_h <= img->crtc_y)
+		return 0;
+
+	/*
+	 * Full-width dual RGB fetches underrun under normal GPU load even when
+	 * their source addresses are separated. Admit no more RGB pixels per
+	 * overlapping scanline than one display-width RGBA line. Narrow dual
+	 * planes retain this tested budget; larger plans must use composition.
+	 * All currently exposed formats have four bytes per pixel, no scaling.
+	 */
+	if (img->crtc_w + osd->crtc_w > d->mode.hdisplay)
+		return -ENOSPC;
+
+	return 0;
+}
+
 static const struct drm_mode_config_funcs sprd_dispc_mode_config_funcs = {
 	.fb_create = drm_gem_fb_create_with_dirty,
-	.atomic_check = drm_atomic_helper_check,
+	.atomic_check = sprd_dispc_atomic_check,
 	.atomic_commit = drm_atomic_helper_commit,
 };
 
