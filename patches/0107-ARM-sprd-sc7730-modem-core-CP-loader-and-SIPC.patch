diff --git a/arch/arm/boot/dts/unisoc/sc7730-modem.dtsi b/arch/arm/boot/dts/unisoc/sc7730-modem.dtsi
new file mode 100644
index 000000000..a3f44c69f
--- /dev/null
+++ b/arch/arm/boot/dts/unisoc/sc7730-modem.dtsi
@@ -0,0 +1,123 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Modem core (CP) of the SC7730 and its SIPC channels, for the boards that
+ * carry the modem (SM-T561) and for tests on the Wi-Fi model (same chip,
+ * same firmware layout). Everything is disabled; a board enables the nodes
+ * and reserves the memory (cp-modem, smem) itself.
+ *
+ * Addresses as in the SM-T561 device trees of the Samsung kernel sources:
+ * CP memory at 0x88000000 (modem image at +0x300000, DSP at +0x20000),
+ * shared memory pool at 0x87800000, smsg ring in the last page of the CP
+ * area. IPI registers 0x402c0000, IRAM1 0x50000000, PMU 0x402b0000.
+ */
+#include <dt-bindings/interrupt-controller/arm-gic.h>
+
+/ {
+	sipc: sipc {
+		compatible = "sprd,sipc";
+		reg = <0x87800000 0x180000>;		/* smem pool */
+		status = "disabled";
+		#address-cells = <1>;
+		#size-cells = <1>;
+		ranges;
+
+		sipc_cpw: sipc-w {
+			sprd,name = "sipc-w";
+			sprd,dst = <2>;
+			reg = <0x402c0000 0x1000>,	/* IPI registers */
+			      <0x89bff000 0x1000>;	/* smsg ring */
+			sprd,ap2cp = <0x0>;		/* offsets in the IPI block */
+			sprd,cp2ap = <0x4>;
+			sprd,trig = <0x01>;
+			sprd,clr = <0x01>;
+			interrupts = <GIC_SPI 68 IRQ_TYPE_LEVEL_HIGH>;
+		};
+	};
+
+	spipe-cpw {
+		compatible = "sprd,spipe";
+		status = "disabled";
+		sprd,name = "spipe_w";
+		sprd,dst = <2>;
+		sprd,channel = <4>;
+		sprd,ringnr = <11>;
+		sprd,size-rxbuf = <0x1000>;
+		sprd,size-txbuf = <0x1000>;
+	};
+
+	slog-cpw {
+		compatible = "sprd,spipe";
+		status = "disabled";
+		sprd,name = "slog_w";
+		sprd,dst = <2>;
+		sprd,channel = <5>;
+		sprd,ringnr = <1>;
+		sprd,size-rxbuf = <0x40000>;
+		sprd,size-txbuf = <0x8000>;
+	};
+
+	stty-cpw {
+		compatible = "sprd,spipe";
+		status = "disabled";
+		sprd,name = "stty_w";
+		sprd,dst = <2>;
+		sprd,channel = <6>;
+		sprd,ringnr = <32>;
+		sprd,size-rxbuf = <0x0800>;
+		sprd,size-txbuf = <0x0800>;
+	};
+
+	seth0-cpw {
+		compatible = "sprd,seth";
+		status = "disabled";
+		sprd,name = "rmnet0";
+		sprd,dst = <2>;
+		sprd,channel = <7>;
+		sprd,blknum = <128>;
+	};
+
+	seth1-cpw {
+		compatible = "sprd,seth";
+		status = "disabled";
+		sprd,name = "rmnet1";
+		sprd,dst = <2>;
+		sprd,channel = <8>;
+		sprd,blknum = <64>;
+	};
+
+	seth2-cpw {
+		compatible = "sprd,seth";
+		status = "disabled";
+		sprd,name = "rmnet2";
+		sprd,dst = <2>;
+		sprd,channel = <9>;
+		sprd,blknum = <64>;
+	};
+
+	scproc_cpw: scproc {
+		compatible = "sprd,scproc";
+		status = "disabled";
+		sprd,name = "cpw";
+		reg = <0x88000000 0x1c00000>,		/* CP memory */
+		      <0x50000000 0xc>,			/* IRAM1: boot routine */
+		      <0x402b0000 0x10000>;		/* PMU */
+		interrupts = <GIC_SPI 84 IRQ_TYPE_LEVEL_HIGH>;	/* CP watchdog */
+		/* <shut_down deep_sleep reset get_status> in the PMU */
+		sprd,ctrl-reg = <0x44 0x44 0xb0 0xbc>;
+		sprd,ctrl-mask = <0x02000000 0x10000000 0x01 0xf0000>;
+		/* ldr r0, [pc]; bx r0; modem image address */
+		sprd,iram-data = <0xe59f0000 0xe12fff10 0x88300000>;
+		#address-cells = <1>;
+		#size-cells = <1>;
+		ranges;
+
+		modem {
+			cproc,name = "modem";
+			reg = <0x88300000 0x800000>;
+		};
+		dsp {
+			cproc,name = "dsp";
+			reg = <0x88020000 0x220000>;
+		};
+	};
+};
