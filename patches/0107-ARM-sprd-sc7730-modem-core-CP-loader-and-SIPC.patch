diff --git a/arch/arm/mach-sprd/cproc.c b/arch/arm/mach-sprd/cproc.c
new file mode 100644
index 000000000..a7997a513
--- /dev/null
+++ b/arch/arm/mach-sprd/cproc.c
@@ -0,0 +1,411 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Modem core (CP) loader and control of the SC7730, ported from
+ * drivers/misc/sprd_cproc/sprd_cproc.c of Samsung's 3.10 kernel sources
+ * (Copyright (C) 2012 Spreadtrum Communications Inc., GPL-2.0).
+ *
+ * The /proc/<name> interface is the one the Spreadtrum userspace uses
+ * (modem_control): write the firmware images to "modem" and "dsp", write
+ * "start" to boot the core, read "wdtirq" to wait for its watchdog.
+ *
+ *   start    boots the core: copies a 3-word jump routine to IRAM1 that
+ *            branches to the modem image, then releases the core in the
+ *            PMU (clear force-shutdown, clear force-deep-sleep, pulse
+ *            reset)
+ *   stop     puts the core back into reset, deep sleep and shutdown
+ *   modem    firmware image window (written at the offset of the file)
+ *   dsp      DSP image window
+ *   mem      the whole CP memory, read only
+ *   status   "started", "stopped" or "wdtirq"
+ *   wdtirq   blocks until the CP watchdog fired, then returns "wdtirq"
+ *
+ * Device tree: see Documentation/devicetree/bindings/misc/sprd,scproc.yaml.
+ */
+#include <linux/delay.h>
+#include <linux/interrupt.h>
+#include <linux/io.h>
+#include <linux/mod_devicetable.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/of_address.h>
+#include <linux/of_irq.h>
+#include <linux/platform_device.h>
+#include <linux/poll.h>
+#include <linux/proc_fs.h>
+#include <linux/slab.h>
+#include <linux/uaccess.h>
+#include <linux/wait.h>
+
+enum { CTRL_SHUT_DOWN, CTRL_DEEP_SLEEP, CTRL_RESET, CTRL_STATUS, CTRL_NR };
+enum { ST_STARTED, ST_STOPPED, ST_WDTIRQ };
+static const char *const st_text[] = { "started\n", "stopped\n", "wdtirq\n" };
+
+#define IRAM_WORDS	3
+#define CHUNK		SZ_64K
+
+struct cproc_seg {
+	const char *name;
+	phys_addr_t base;
+	size_t size;
+};
+
+struct cproc {
+	struct device *dev;
+	const char *name;
+	phys_addr_t base;
+	size_t size;
+	phys_addr_t iram;
+	void __iomem *pmu;
+	u32 reg[CTRL_NR];
+	u32 mask[CTRL_NR];
+	u32 iram_data[IRAM_WORDS];
+	struct cproc_seg seg[2];	/* modem, dsp */
+	int status;
+	bool wdt;
+	wait_queue_head_t wait;
+	struct mutex lock;
+	struct proc_dir_entry *dir;
+};
+
+static void cp_pmu_set(struct cproc *c, int which)
+{
+	u32 v = readl(c->pmu + c->reg[which]);
+
+	writel(v | c->mask[which], c->pmu + c->reg[which]);
+}
+
+static void cp_pmu_clr(struct cproc *c, int which)
+{
+	u32 v = readl(c->pmu + c->reg[which]);
+
+	writel(v & ~c->mask[which], c->pmu + c->reg[which]);
+}
+
+static int cp_start(struct cproc *c)
+{
+	void __iomem *iram;
+	int i;
+
+	iram = ioremap(c->iram, 0x1000);
+	if (!iram)
+		return -ENOMEM;
+	for (i = 0; i < IRAM_WORDS; i++)
+		writel(c->iram_data[i], iram + 4 * i);
+	iounmap(iram);
+
+	cp_pmu_clr(c, CTRL_SHUT_DOWN);
+	msleep(50);
+	cp_pmu_clr(c, CTRL_DEEP_SLEEP);
+	msleep(50);
+	cp_pmu_set(c, CTRL_RESET);
+	msleep(200);
+	cp_pmu_clr(c, CTRL_RESET);
+	for (i = 0; i < 1000; i++) {
+		if (!(readl(c->pmu + c->reg[CTRL_RESET]) & c->mask[CTRL_RESET]))
+			break;
+		msleep(1);
+	}
+	if (i == 1000)
+		dev_warn(c->dev, "reset bit does not clear\n");
+	c->wdt = false;
+	c->status = ST_STARTED;
+	dev_info(c->dev, "%s started\n", c->name);
+	return 0;
+}
+
+static int cp_stop(struct cproc *c)
+{
+	int i;
+
+	/* wait until the core has gone to sleep (PMU 0xb4 bit 0) */
+	for (i = 0; i < 500; i++) {
+		if (readl(c->pmu + 0xb4) & 1)
+			break;
+		msleep(1);
+	}
+	if (i == 500)
+		dev_warn(c->dev, "core does not enter sleep, stopping anyway\n");
+	cp_pmu_set(c, CTRL_RESET);
+	cp_pmu_set(c, CTRL_DEEP_SLEEP);
+	cp_pmu_set(c, CTRL_SHUT_DOWN);
+	c->status = ST_STOPPED;
+	dev_info(c->dev, "%s stopped\n", c->name);
+	return 0;
+}
+
+static irqreturn_t cp_wdt_irq(int irq, void *data)
+{
+	struct cproc *c = data;
+
+	dev_err(c->dev, "%s watchdog fired\n", c->name);
+	c->wdt = true;
+	c->status = ST_WDTIRQ;
+	wake_up_interruptible_all(&c->wait);
+	return IRQ_HANDLED;
+}
+
+/* copy between user space and CP memory, a chunk at a time */
+static ssize_t cp_copy(phys_addr_t base, size_t size, char __user *ubuf,
+		       const char __user *cbuf, size_t count, loff_t *ppos)
+{
+	loff_t pos = *ppos;
+	size_t done = 0;
+	void *tmp;
+
+	if (pos >= size)
+		return 0;
+	count = min_t(size_t, count, size - pos);
+	tmp = kmalloc(CHUNK, GFP_KERNEL);
+	if (!tmp)
+		return -ENOMEM;
+	while (done < count) {
+		size_t n = min_t(size_t, CHUNK, count - done);
+		void __iomem *m = memremap(base + pos + done, n, MEMREMAP_WC);
+
+		if (!m) {
+			kfree(tmp);
+			return done ? done : -ENOMEM;
+		}
+		if (ubuf) {
+			memcpy_fromio(tmp, m, n);
+			if (copy_to_user(ubuf + done, tmp, n)) {
+				memunmap(m);
+				kfree(tmp);
+				return done ? done : -EFAULT;
+			}
+		} else {
+			if (copy_from_user(tmp, cbuf + done, n)) {
+				memunmap(m);
+				kfree(tmp);
+				return done ? done : -EFAULT;
+			}
+			memcpy_toio(m, tmp, n);
+		}
+		memunmap(m);
+		done += n;
+	}
+	kfree(tmp);
+	*ppos += done;
+	return done;
+}
+
+enum { P_START, P_STOP, P_MODEM, P_DSP, P_STATUS, P_WDTIRQ, P_MEM, P_NR };
+static const char *const pname[P_NR] = {
+	"start", "stop", "modem", "dsp", "status", "wdtirq", "mem"
+};
+
+struct cp_file {
+	struct cproc *c;
+	int which;
+};
+
+static ssize_t cp_read(struct file *f, char __user *buf, size_t count, loff_t *ppos)
+{
+	struct cp_file *pf = pde_data(file_inode(f));
+	struct cproc *c = pf->c;
+	const char *t;
+	size_t len;
+
+	switch (pf->which) {
+	case P_MEM:
+		return cp_copy(c->base, c->size, buf, NULL, count, ppos);
+	case P_STATUS:
+		t = st_text[c->status];
+		break;
+	case P_WDTIRQ:
+		if (wait_event_interruptible(c->wait, c->wdt))
+			return -ERESTARTSYS;
+		t = st_text[ST_WDTIRQ];
+		break;
+	default:
+		return -EINVAL;
+	}
+	len = strlen(t);
+	if (*ppos >= len)
+		return 0;
+	count = min(count, len - (size_t)*ppos);
+	if (copy_to_user(buf, t + *ppos, count))
+		return -EFAULT;
+	*ppos += count;
+	return count;
+}
+
+static ssize_t cp_write(struct file *f, const char __user *buf, size_t count, loff_t *ppos)
+{
+	struct cp_file *pf = pde_data(file_inode(f));
+	struct cproc *c = pf->c;
+	struct cproc_seg *s;
+	ssize_t ret;
+
+	mutex_lock(&c->lock);
+	switch (pf->which) {
+	case P_START:
+		ret = cp_start(c);
+		break;
+	case P_STOP:
+		ret = cp_stop(c);
+		break;
+	case P_MODEM:
+	case P_DSP:
+		s = &c->seg[pf->which == P_DSP];
+		ret = cp_copy(s->base, s->size, NULL, buf, count, ppos);
+		if (ret == 0 && *ppos >= s->size) {
+			*ppos += count;	/* past the end: pretend to have written it */
+			ret = count;
+		}
+		mutex_unlock(&c->lock);
+		return ret;
+	default:
+		ret = -EINVAL;
+	}
+	mutex_unlock(&c->lock);
+	return ret ? ret : count;
+}
+
+static loff_t cp_lseek(struct file *f, loff_t off, int whence)
+{
+	struct cp_file *pf = pde_data(file_inode(f));
+	loff_t new;
+
+	switch (whence) {
+	case SEEK_SET:
+		new = off;
+		break;
+	case SEEK_CUR:
+		new = f->f_pos + off;
+		break;
+	case SEEK_END:
+		if (pf->which != P_MEM)
+			return -EINVAL;
+		new = pf->c->size + off;
+		break;
+	default:
+		return -EINVAL;
+	}
+	if (new < 0)
+		return -EINVAL;
+	f->f_pos = new;
+	return new;
+}
+
+static __poll_t cp_poll(struct file *f, poll_table *wait)
+{
+	struct cp_file *pf = pde_data(file_inode(f));
+	struct cproc *c = pf->c;
+
+	if (pf->which != P_WDTIRQ)
+		return EPOLLERR;
+	poll_wait(f, &c->wait, wait);
+	return c->wdt ? EPOLLIN | EPOLLRDNORM : 0;
+}
+
+static const struct proc_ops cp_proc_ops = {
+	.proc_read	= cp_read,
+	.proc_write	= cp_write,
+	.proc_lseek	= cp_lseek,
+	.proc_poll	= cp_poll,
+};
+
+static int cp_parse_seg(struct device_node *np, struct cproc *c)
+{
+	struct device_node *ch;
+	int n = 0;
+
+	for_each_child_of_node(np, ch) {
+		struct resource res;
+		const char *name;
+
+		if (n >= 2 || of_property_read_string(ch, "cproc,name", &name) ||
+		    of_address_to_resource(ch, 0, &res)) {
+			of_node_put(ch);
+			return -EINVAL;
+		}
+		c->seg[n].name = name;
+		c->seg[n].base = res.start;
+		c->seg[n].size = resource_size(&res);
+		n++;
+	}
+	return n == 2 ? 0 : -EINVAL;
+}
+
+static int cproc_probe(struct platform_device *pdev)
+{
+	struct device_node *np = pdev->dev.of_node;
+	struct cproc *c;
+	struct resource res;
+	struct cp_file *files;
+	int irq, i, ret;
+
+	c = devm_kzalloc(&pdev->dev, sizeof(*c), GFP_KERNEL);
+	files = devm_kcalloc(&pdev->dev, P_NR, sizeof(*files), GFP_KERNEL);
+	if (!c || !files)
+		return -ENOMEM;
+	c->dev = &pdev->dev;
+	init_waitqueue_head(&c->wait);
+	mutex_init(&c->lock);
+	c->status = ST_STOPPED;
+
+	ret = of_property_read_string(np, "sprd,name", &c->name);
+	if (ret)
+		return ret;
+	ret = of_property_read_u32_array(np, "sprd,ctrl-reg", c->reg, CTRL_NR);
+	if (!ret)
+		ret = of_property_read_u32_array(np, "sprd,ctrl-mask", c->mask, CTRL_NR);
+	if (!ret)
+		ret = of_property_read_u32_array(np, "sprd,iram-data", c->iram_data, IRAM_WORDS);
+	if (ret)
+		return ret;
+	ret = cp_parse_seg(np, c);
+	if (ret)
+		return dev_err_probe(&pdev->dev, ret, "need a modem and a dsp child node\n");
+
+	if (of_address_to_resource(np, 0, &res))
+		return -EINVAL;
+	c->base = res.start;
+	c->size = resource_size(&res);
+	if (of_address_to_resource(np, 1, &res))
+		return -EINVAL;
+	c->iram = res.start;
+	c->pmu = devm_platform_ioremap_resource(pdev, 2);
+	if (IS_ERR(c->pmu))
+		return PTR_ERR(c->pmu);
+
+	irq = platform_get_irq(pdev, 0);
+	if (irq < 0)
+		return irq;
+	ret = devm_request_irq(&pdev->dev, irq, cp_wdt_irq, 0, "cpw", c);
+	if (ret)
+		return ret;
+
+	c->dir = proc_mkdir(c->name, NULL);
+	if (!c->dir)
+		return -ENOMEM;
+	for (i = 0; i < P_NR; i++) {
+		files[i].c = c;
+		files[i].which = i;
+		if (!proc_create_data(pname[i], 0200, c->dir, &cp_proc_ops, &files[i])) {
+			remove_proc_subtree(c->name, NULL);
+			return -ENOMEM;
+		}
+	}
+	platform_set_drvdata(pdev, c);
+	dev_info(&pdev->dev, "%s: memory %pa+%zx, modem %pa+%zx, dsp %pa+%zx, /proc/%s\n",
+		 c->name, &c->base, c->size, &c->seg[0].base, c->seg[0].size,
+		 &c->seg[1].base, c->seg[1].size, c->name);
+	return 0;
+}
+
+static const struct of_device_id cproc_of_match[] = {
+	{ .compatible = "sprd,scproc" },
+	{ }
+};
+
+static struct platform_driver cproc_driver = {
+	.driver = {
+		.name = "sprd-cproc",
+		.of_match_table = cproc_of_match,
+		.suppress_bind_attrs = true,
+	},
+	.probe = cproc_probe,
+};
+builtin_platform_driver(cproc_driver);
