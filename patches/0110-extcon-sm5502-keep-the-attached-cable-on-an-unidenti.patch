From 389a6700fdab4ce652115a72b171da710b434149 Mon Sep 17 00:00:00 2001
From: Deniz Kokden <koekdendeniz@gmail.com>
Date: Sat, 7 Nov 2026 12:14:00 +0000
Subject: [PATCH 110/116] extcon: sm5502: keep the attached cable on an
 unidentified state

When the device type registers did not identify a cable, the driver
stored -EINVAL as the previous cable type, so the following detach did
not clear the cable that was really attached. Only remember identified
cables.

Assisted-by: Claude Opus 5.5
---
 drivers/extcon/extcon-sm5502.c | 18 +++++++++++++++---
 1 file changed, 15 insertions(+), 3 deletions(-)

diff --git a/drivers/extcon/extcon-sm5502.c b/drivers/extcon/extcon-sm5502.c
index f82d847ea..ddddfc56a 100644
--- a/drivers/extcon/extcon-sm5502.c
+++ b/drivers/extcon/extcon-sm5502.c
@@ -483,10 +483,22 @@ static int sm5502_muic_cable_handler(struct sm5502_muic_info *info,
 	int ret;
 
 	/* Get the type of attached or detached cable */
-	if (attached)
-		cable_type = sm5502_muic_get_cable_type(info);
-	else
+	if (attached) {
+		ret = sm5502_muic_get_cable_type(info);
+		/*
+		 * An unidentifiable state (e.g. VBUS appearing next to an
+		 * OTG cable) must not make us forget the cable that is
+		 * attached: the detach would then match nothing and the
+		 * cable state would stay set for good.
+		 */
+		if (ret == -EINVAL)
+			return 0;
+		if (ret < 0)
+			return ret;
+		cable_type = ret;
+	} else {
 		cable_type = prev_cable_type;
+	}
 	prev_cable_type = cable_type;
 
 	switch (cable_type) {
