CONFIG_LOCALVERSION="-gtelwifi"
CONFIG_MMU=y
CONFIG_ARCH_MULTIPLATFORM=y
CONFIG_ARCH_MULTI_V7=y
CONFIG_ARCH_SPRD=y
CONFIG_SPRD_BOOTSTRIPES=y
CONFIG_SMP=y
CONFIG_NR_CPUS=4
CONFIG_HOTPLUG_CPU=y
CONFIG_HIGHMEM=y
CONFIG_VMSPLIT_3G=y
CONFIG_AEABI=y
CONFIG_VFP=y
CONFIG_VFPv3=y
CONFIG_NEON=y
CONFIG_ARM_PATCH_PHYS_VIRT=y
CONFIG_AUTO_ZRELADDR=y
CONFIG_ATAGS=n
CONFIG_ARM_APPENDED_DTB=n
CONFIG_ARM_ERRATA_814220=y
CONFIG_CMDLINE="console=tty0 printk.devkmsg=on vt.global_cursor_default=0 loglevel=7 panic=10 printk.time=1 fbcon=font:TER16x32"
CONFIG_CMDLINE_EXTEND=y
CONFIG_HZ_250=y
CONFIG_NO_HZ_IDLE=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_BUG=y
CONFIG_KALLSYMS=y
CONFIG_MULTIUSER=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_SHMEM=y
CONFIG_POSIX_TIMERS=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_INITRAMFS_SOURCE="@INITRAMFS@"
CONFIG_RD_GZIP=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVMEM=y
CONFIG_STRICT_DEVMEM=n
CONFIG_TTY=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_UNIX98_PTYS=y
CONFIG_FB=y
CONFIG_FB_SIMPLE=n
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_ROTATION=y
CONFIG_FONTS=y
CONFIG_FONT_8x16=y
CONFIG_FONT_TER16x32=y
CONFIG_COMMON_CLK=y
CONFIG_SERIAL_SPRD=y
CONFIG_SERIAL_SPRD_CONSOLE=y
CONFIG_MISC_FILESYSTEMS=y
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PANIC_TIMEOUT=0
CONFIG_MODULES=n
CONFIG_KERNEL_GZIP=y
CONFIG_COMPAT_32BIT_TIME=y
CONFIG_CONFIGFS_FS=y
CONFIG_USB_SUPPORT=y
CONFIG_USB_GADGET=y
CONFIG_USB_DWC2=y
CONFIG_USB_DWC2_PERIPHERAL=y
CONFIG_USB_ROLE_SWITCH=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_SPRD_USB_BRINGUP=y
CONFIG_VT_HW_CONSOLE_BINDING=y
CONFIG_NET=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_UNIX=y
CONFIG_PACKET=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_NETDEVICES=y
CONFIG_BLOCK=y
CONFIG_PARTITION_ADVANCED=y
CONFIG_EFI_PARTITION=y
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_BLOCK_MINORS=32
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_SC7730=y
CONFIG_SPRD_RESTART=y
CONFIG_DEBUG_FS=y
CONFIG_EXT4_FS=y
CONFIG_FILE_LOCKING=y
CONFIG_INOTIFY_USER=y
CONFIG_SYSVIPC=y
CONFIG_BLK_DEV_WRITE_MOUNTED=y
CONFIG_BLK_DEV=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_I2C=y
CONFIG_I2C_CHARDEV=y
CONFIG_I2C_SPRD_SC8830=y
CONFIG_I2C_GPIO=y
CONFIG_POWER_SUPPLY=y
CONFIG_CHARGER_SMB347=y
CONFIG_EXTCON=y
CONFIG_EXTCON_SM5502=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_SPRD_SC8830=y
CONFIG_KEYBOARD_GPIO=y
# SC2723: regmap + interrupts, mainline EIC (power/volume down) and RTC
CONFIG_SPRD_SC2723_PMIC=y
CONFIG_GPIO_PMIC_EIC_SPRD=y
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_SC27XX=y
CONFIG_SPRD_CLK_AUX0=y
CONFIG_SPRD_SC2723_FGU=y
CONFIG_IIO=y
CONFIG_SPRD_SC2723_ADC=y
CONFIG_PWRSEQ_SIMPLE=y
CONFIG_WIRELESS=y
CONFIG_CFG80211=y
CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_BROADCOM=y
CONFIG_BRCMFMAC=y
CONFIG_BRCMFMAC_SDIO=y
CONFIG_FW_LOADER=y
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y
CONFIG_GPIOLIB=y
CONFIG_GPIO_SPRD=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
# GPS power (TCXO + GPS_PWR_EN) as a "regulator-output" for glgps
CONFIG_REGULATOR_USERSPACE_CONSUMER=y
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_ZINITIX=y
CONFIG_PREEMPT=y
# backlight: PWM3 + pwm-backlight, switched by simpledrm with the CRTC
CONFIG_PWM=y
CONFIG_PWM_SPRD_SC8830=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_PWM=y
# microSD: SC2723 LDO vddsdcore
CONFIG_SPRD_SC2723_LDO=y
CONFIG_VFAT_FS=y
CONFIG_EXFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
# Bluetooth: UART0 (sprd_serial with a gate clock) + hci_bcm
CONFIG_SPRD_CLK_GATES=y
CONFIG_SERIAL_DEV_BUS=y
CONFIG_SERIAL_DEV_CTRL_TTYPORT=y
CONFIG_BT=y
CONFIG_BT_BREDR=y
CONFIG_BT_LE=y
CONFIG_BT_HCIUART=y
CONFIG_BT_HCIUART_BCM=y
# GPIO character device (camera bring-up from user space)
CONFIG_GPIO_CDEV=y
# accelerometer LIS2HH12 on I2C2
CONFIG_IIO_ST_ACCEL_3AXIS=y
CONFIG_IIO_ST_ACCEL_I2C_3AXIS=y
# standby: suspend to "mem" = CPU1-3 off, CPU0 in WFI (mach-sprd/sc7730.c)
CONFIG_PM=y
CONFIG_SUSPEND=y
CONFIG_PM_DEBUG=y
CONFIG_PM_SLEEP_DEBUG=y
# GPU: Mali-400 MP2 with lima, power domains from mach-sprd/pm-domains.c
CONFIG_SPRD_SC7730_PM_DOMAINS=y
CONFIG_DRM_LIMA=y
# for Nura/pmOS: running config in /proc/config.gz, Adiantum for FDE without AES instructions
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_CRYPTO=y
CONFIG_CRYPTO_ADIANTUM=y
# display: DISPC takeover driver instead of simpledrm, CMA for its buffers
CONFIG_CMA=y
CONFIG_DMA_CMA=y
CONFIG_DRM_SPRD_DISPC=y
# audio: AP DMA (r4p0 variant of sprd-dma), VBC DAI, SC2723 codec, simple-audio-card (speaker)
CONFIG_DMADEVICES=y
CONFIG_SPRD_DMA=y
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_SOC_SPRD=y
CONFIG_SND_SOC_SPRD_VBC_SC7730=y
CONFIG_SND_SOC_SC2723=y
CONFIG_SND_SIMPLE_CARD=y
# SoC temperature sensor, thermal zone with critical shutdown at 110 C
CONFIG_THERMAL=y
CONFIG_THERMAL_OF=y
CONFIG_SPRD_SC7730_THERMAL=y
# CPU frequency scaling: MPLL/TDPLL cluster clock, SC2723 DCDC_ARM, OPP table, cpufreq-dt, thermal cooling
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_STAT=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_POWERSAVE=y
CONFIG_CPU_FREQ_GOV_USERSPACE=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_CPUFREQ_DT=y
CONFIG_CPU_THERMAL=y
CONFIG_SPRD_CLK_CPU=y
CONFIG_SPRD_SC2723_DCDC_ARM=y
# Camera: DCAM/CSI-2 capture + front sensor SR200PC20M
CONFIG_MEDIA_SUPPORT=y
CONFIG_MEDIA_SUPPORT_FILTER=y
CONFIG_MEDIA_CAMERA_SUPPORT=y
CONFIG_MEDIA_PLATFORM_SUPPORT=y
CONFIG_VIDEO_DEV=y
CONFIG_MEDIA_CONTROLLER=y
CONFIG_MEDIA_PLATFORM_DRIVERS=y
CONFIG_V4L_PLATFORM_DRIVERS=y
CONFIG_VIDEO_CAMERA_SENSOR=y
CONFIG_VIDEO_SR200PC20M=y
CONFIG_VIDEO_SC7730_DCAM=y
CONFIG_VIDEO_S5K4ECGX=y
